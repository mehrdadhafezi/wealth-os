# Copy this file to api/.env on your PHP host and fill in real values.
# On cPanel, these can instead be set as real environment variables if your
# hosting plan supports it — real env vars always take precedence over this file.

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Origin allowed to call this API (your frontend's URL). Use * only for local dev.
CORS_ORIGIN=*
