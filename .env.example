# Base URL of the PHP API (see api/ folder). `npm run dev` proxies /api to a local
# PHP server (see api/.env.example + README "Local development" section), so the
# default of /api works out of the box. Override only if your PHP server runs on a
# different host/port, or once the api/ folder is deployed to your cPanel host
# (e.g. https://yourdomain.com/api).
VITE_API_BASE_URL=/api

# Used by the /api/claude Vercel serverless function (Phase 2), not by the frontend directly
ANTHROPIC_API_KEY=
