# Base URL of the PHP API (see api/ folder). e.g. http://localhost:8000/api in dev,
# or https://yourdomain.com/api once the api/ folder is deployed to your cPanel host.
VITE_API_BASE_URL=/api

# Used by the /api/claude Vercel serverless function (Phase 2), not by the frontend directly
ANTHROPIC_API_KEY=
